LAZHELPER_ALLOWED_ROOT=./workspace
LAZHELPER_MAX_FILES=1500
LAZHELPER_MAX_DEPTH=8
LAZHELPER_MAX_FILE_MB=20
LAZHELPER_MAX_TEXT_CHARS=18000
# Local Ollama default; Render's Blueprint uses https://ollama.com/api for Ollama Cloud.
LAZHELPER_OLLAMA_URL=http://127.0.0.1:11434
LAZHELPER_OLLAMA_MODEL=gemma3:1b
# Set this only in your private environment; never commit a real key.
OLLAMA_API_KEY=
LAZHELPER_AI_TIMEOUT_SECONDS=45
# Required: use a PostgreSQL connection URL for every environment.
# Render Blueprints populate DATABASE_URL automatically for the hosted service.
DATABASE_URL=
